rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.superAdmin == true;
    }

    function staffPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid);
    }

    function sessionPath(restaurantId, sessionId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/sessions/$(sessionId);
    }

    function isActiveStaff(restaurantId) {
      return isSignedIn()
        && exists(staffPath(restaurantId))
        && get(staffPath(restaurantId)).data.active == true;
    }

    function hasRole(restaurantId, role) {
      return isActiveStaff(restaurantId)
        && get(staffPath(restaurantId)).data.role == role;
    }

    function isAdmin(restaurantId) {
      return hasRole(restaurantId, "admin");
    }

    function isRunner(restaurantId) {
      return hasRole(restaurantId, "runner");
    }

    function isCashier(restaurantId) {
      return hasRole(restaurantId, "cashier");
    }

    function isKitchen(restaurantId) {
      return hasRole(restaurantId, "kitchen");
    }

    function isBar(restaurantId) {
      return hasRole(restaurantId, "bar");
    }

    function isCashierOrAdmin(restaurantId) {
      return isCashier(restaurantId) || isAdmin(restaurantId);
    }

    // F-08: isRunnerOrAdmin eliminado — no se usaba en ninguna regla.

    function isRunnerCashierOrAdmin(restaurantId) {
      return isRunner(restaurantId)
        || isCashier(restaurantId)
        || isAdmin(restaurantId);
    }

    function isWaitlistStaff(restaurantId) {
      // No existe rol reception todavía; Waitlist queda aislado para sumarlo acá.
      return isRunnerCashierOrAdmin(restaurantId);
    }

    function isKitchenBarRunnerCashierOrAdmin(restaurantId) {
      return isKitchen(restaurantId)
        || isBar(restaurantId)
        || isRunner(restaurantId)
        || isCashier(restaurantId)
        || isAdmin(restaurantId);
    }

    function isPremiumRestaurant(restaurantId) {
      return get(
        /databases/$(database)/documents/restaurants/$(restaurantId)
      ).data.plan == "premium";
    }

    function isOwnerCreatingRestaurant() {
      return isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.subscriptionStatus == "trial"
        && request.resource.data.active == true;
    }

    function isOwnerCreatingOwnStaff(restaurantId, staffId) {
      return isSignedIn()
        && staffId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "admin"
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid
           == request.auth.uid;
    }

    // Permite escribir documentos adicionales (public/branding, mesas) en el mismo
    // batch de onboarding, cuando el restaurante que se está creando tiene ownerUid == uid.
    function isOwnerCreatingForRestaurant(restaurantId) {
      return isSignedIn()
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid
           == request.auth.uid;
    }

    function isValidTableNumber(value) {
      return value is int && value > 0 && value <= 500;
    }

    function isValidOptionalString(value) {
      return value == null || value is string;
    }

    function isValidOptionalColor(value) {
      return value == null || value is string;
    }

    function isValidWaitlistWhatsAppSettings(value) {
      return value is map
        && value.keys().hasAll(['restaurantPhone', 'messageTemplate'])
        && value.keys().hasOnly(['restaurantPhone', 'messageTemplate'])
        && value.restaurantPhone is string
        && value.restaurantPhone.size() <= 40
        && value.messageTemplate is string
        && value.messageTemplate.size() > 0
        && value.messageTemplate.size() <= 1000;
    }

    function isValidRestaurantUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'logoUrl', 'coverUrl', 'welcomeMessage',
                    'primaryColor', 'secondaryColor', 'waitlistWhatsApp',
                    'updatedAt'])
        && isValidOptionalString(request.resource.data.name)
        && isValidOptionalString(request.resource.data.logoUrl)
        && isValidOptionalString(request.resource.data.coverUrl)
        && isValidOptionalString(request.resource.data.welcomeMessage)
        && isValidOptionalColor(request.resource.data.primaryColor)
        && isValidOptionalColor(request.resource.data.secondaryColor)
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['waitlistWhatsApp'])
          || isValidWaitlistWhatsAppSettings(request.resource.data.waitlistWhatsApp)
        );
    }

    function sessionExists(restaurantId, sessionId) {
      return sessionId is string
        && exists(sessionPath(restaurantId, sessionId));
    }

    // F-07: Consolidado en un solo get() usando let para evitar 4 lecturas repetidas.
    // Comportamiento idéntico al anterior — solo mejora de legibilidad y eficiencia.
    function sessionIsActiveForTable(restaurantId, sessionId, tableNumber) {
      let s = get(sessionPath(restaurantId, sessionId)).data;
      return sessionExists(restaurantId, sessionId)
        && s.restaurantId == restaurantId
        && s.tableNumber == tableNumber
        && s.status == "active"
        && s.ordersLocked != true
        && s.billRequested != true;
    }

    function validClientSessionCreate(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && isValidTableNumber(request.resource.data.tableNumber)
        && request.resource.data.status == "active";
    }

    function isValidAuditLog(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.action is string
        && request.resource.data.actorUid is string
        && request.resource.data.actorRole is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.description is string
        && request.resource.data.changes is map
        && request.resource.data.changes.before is map
        && request.resource.data.changes.after is map
        && request.resource.data.metadata is map
        && request.resource.data.createdAt == request.time;
    }

    function isValidStaffAuditLog(restaurantId) {
      return isActiveStaff(restaurantId)
        && request.resource.data.actorUid == request.auth.uid;
    }

    function isValidCustomerAuditLog(restaurantId) {
      return request.resource.data.actorRole == "customer"
        && request.resource.data.sessionId is string
        && request.resource.data.actorUid
           == "customer:" + request.resource.data.sessionId
        && isValidTableNumber(request.resource.data.mesa)
        && sessionExists(restaurantId, request.resource.data.sessionId)
        && getAfter(sessionPath(restaurantId, request.resource.data.sessionId)).data.tableNumber
           == request.resource.data.mesa
        && (
          (
            request.resource.data.action == "cuenta_solicitada"
            && getAfter(sessionPath(restaurantId, request.resource.data.sessionId)).data.billRequested
               == true
          )
          || (
            request.resource.data.action == "asistencia_solicitada"
            && getAfter(sessionPath(restaurantId, request.resource.data.sessionId)).data.status
               == "active"
          )
        );
    }

    match /restaurants/{restaurantId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);

      allow create: if isSuperAdmin() || isOwnerCreatingRestaurant();

      allow update: if isSuperAdmin()
        || (
          isAdmin(restaurantId)
          && isValidRestaurantUpdate()
        );

      allow delete: if isSuperAdmin();
    }

    match /restaurants/{restaurantId}/public/{docId} {
      // Campos públicos de branding: name, logoUrl, coverUrl, primaryColor,
      // secondaryColor, welcomeMessage, active. Sin billing ni datos privados.
      allow read: if true;
      allow write: if isSuperAdmin()
        || isAdmin(restaurantId)
        || isOwnerCreatingForRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/staff/{staffId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);

      allow create: if isSuperAdmin()
        || isAdmin(restaurantId)
        || isOwnerCreatingOwnStaff(restaurantId, staffId);

      allow update, delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    match /restaurants/{restaurantId}/mesas/{mesaId} {
      allow read: if true;

      allow create: if (
          isSuperAdmin()
          || isAdmin(restaurantId)
          || isCashier(restaurantId)
          || isOwnerCreatingForRestaurant(restaurantId)
        )
        && request.resource.data.restaurantId == restaurantId
        && isValidTableNumber(request.resource.data.numero)
        && request.resource.data.estado in ["available", "occupied", "needs_cleaning"];

      allow update: if isSuperAdmin()
        || isRunnerCashierOrAdmin(restaurantId)
        || (
          resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId
          && isValidTableNumber(request.resource.data.numero)
          && request.resource.data.numero == resource.data.numero
          && request.resource.data.estado == "occupied"
          && request.resource.data.activeSessionId is string
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/sessions/$(request.resource.data.activeSessionId)).data.status == "active"
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/sessions/$(request.resource.data.activeSessionId)).data.tableNumber == request.resource.data.numero
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/sessions/$(request.resource.data.activeSessionId)).data.restaurantId == restaurantId
        );

      allow delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    match /restaurants/{restaurantId}/sessions/{sessionId} {
      allow read: if isSuperAdmin() || isRunnerCashierOrAdmin(restaurantId);
      // Cualquier usuario (incluso signed-in no-staff) puede GET una sesión por su ID.
      // El ID es UUID/no guessable y no contiene PII ni datos de pago.
      // Necesario para el flujo QR cuando Firebase Auth restaura una sesión previa desde storage.
      allow get: if true;

      allow create: if isCashierOrAdmin(restaurantId)
        || validClientSessionCreate(restaurantId);

      allow update: if isSuperAdmin()
        || isRunnerCashierOrAdmin(restaurantId)
        || (
          resource.data.status == "active"
          && request.resource.data.status == "active"
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.tableNumber == resource.data.tableNumber
          && (request.resource.data.ordersLocked == resource.data.ordersLocked
              || request.resource.data.ordersLocked == true)
          && (request.resource.data.billRequested == resource.data.billRequested
              || request.resource.data.billRequested == true)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['ordersLocked', 'billRequested', 'billRequestedAt',
                         'lockedReason', 'updatedAt'])
        );

      allow delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    match /restaurants/{restaurantId}/menu/{itemId} {
      allow read: if resource.data.active == true || isActiveStaff(restaurantId);

      allow create, delete: if isSuperAdmin() || isAdmin(restaurantId);

      allow update: if isSuperAdmin() || isAdmin(restaurantId)
        || (
          (isKitchen(restaurantId) || isBar(restaurantId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        );
    }

    match /restaurants/{restaurantId}/pedidos/{pedidoId} {
      // F-03: lectura anónima eliminada. RequestBill.tsx y bill.ts leen
      // pedidos via /api/get-session-bill (Admin SDK, validación server-side).
      allow get: if isSuperAdmin()
        || isKitchenBarRunnerCashierOrAdmin(restaurantId)
        || (
          resource.data.sessionId is string
          && isValidTableNumber(resource.data.mesa)
          && sessionExists(restaurantId, resource.data.sessionId)
          && get(sessionPath(restaurantId, resource.data.sessionId)).data.restaurantId
               == restaurantId
          && get(sessionPath(restaurantId, resource.data.sessionId)).data.tableNumber
               == resource.data.mesa
        );

      allow list: if isSuperAdmin()
        || isKitchenBarRunnerCashierOrAdmin(restaurantId);

      allow create: if request.resource.data.restaurantId == restaurantId
        && isValidTableNumber(request.resource.data.mesa)
        && request.resource.data.sessionId is string
        && sessionIsActiveForTable(
          restaurantId,
          request.resource.data.sessionId,
          request.resource.data.mesa
        )
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;

      allow update: if isKitchenBarRunnerCashierOrAdmin(restaurantId);

      allow delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    match /restaurants/{restaurantId}/cuentas/{cuentaId} {
      allow read: if isSuperAdmin() || isRunnerCashierOrAdmin(restaurantId);
      // resource == null cubre el caso en que la cuenta no existe todavía
      // (el cliente lee dentro de una transacción para saber si crear o actualizar).
      // Cuando existe, solo puede leerla quien conoce su propio sessionId.
      allow get: if resource == null || resource.data.sessionId == cuentaId;

      allow create: if (
          request.resource.data.restaurantId == restaurantId
          && isValidTableNumber(request.resource.data.mesa)
          && request.resource.data.sessionId is string
          && sessionExists(restaurantId, request.resource.data.sessionId)
          // F-06: cross-check que la sesión pertenece a la misma mesa.
          // Usa get() que lee estado pre-transacción: tableNumber no cambia en pedirCuenta().
          && get(sessionPath(restaurantId, request.resource.data.sessionId)).data.tableNumber
             == request.resource.data.mesa
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.estado == "pendiente"
        )
        || isCashierOrAdmin(restaurantId);

      allow update: if isRunnerCashierOrAdmin(restaurantId);

      // F-05: solo superAdmin puede borrar audit logs — admin del restaurante no.
      allow delete: if isSuperAdmin();
    }

    match /restaurants/{restaurantId}/payments/{paymentId} {
      allow read: if isSuperAdmin() || isCashierOrAdmin(restaurantId);

      allow create: if isSuperAdmin()
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.type is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;

      allow update, delete: if isSuperAdmin();
    }

    match /restaurants/{restaurantId}/stock/{stockItemId} {
      // F-01: stock restringido a staff autenticado y superAdmin.
      // useMenuData.ts no carga stock para usuarios anónimos.
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);

      allow create: if (isSuperAdmin() || isAdmin(restaurantId))
        && isPremiumRestaurant(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.unit in ["kg", "g", "l", "ml", "unit"]
        && request.resource.data.currentQuantity is number
        && request.resource.data.currentQuantity >= 0
        && request.resource.data.minimumQuantity is number
        && request.resource.data.minimumQuantity >= 0
        && request.resource.data.active is bool;

      allow update: if (isSuperAdmin() || isAdmin(restaurantId))
        && isPremiumRestaurant(restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.unit in ["kg", "g", "l", "ml", "unit"]
        && request.resource.data.currentQuantity is number
        && request.resource.data.currentQuantity >= 0
        && request.resource.data.minimumQuantity is number
        && request.resource.data.minimumQuantity >= 0
        && request.resource.data.active is bool;

      allow delete: if (isSuperAdmin() || isAdmin(restaurantId))
        && isPremiumRestaurant(restaurantId);
    }

    match /restaurants/{restaurantId}/auditLogs/{auditLogId} {
      allow read: if isSuperAdmin() || isAdmin(restaurantId);

      allow create: if isValidAuditLog(restaurantId)
        && (
          (isSuperAdmin()
            && request.resource.data.actorUid == request.auth.uid)
          || isValidStaffAuditLog(restaurantId)
          || isValidCustomerAuditLog(restaurantId)
        );

      allow update: if false;
      allow delete: if false;
    }

    match /restaurants/{restaurantId}/assistanceRequests/{requestId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);

      allow create: if isValidTableNumber(request.resource.data.mesa)
        && request.resource.data.type in ["sal", "hielo", "runner"]
        && request.resource.data.status == "pending"
        && sessionIsActiveForTable(
             restaurantId,
             request.resource.data.sessionId,
             request.resource.data.mesa
           );

      allow update: if isSuperAdmin() || isRunnerCashierOrAdmin(restaurantId);
      allow delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    // Facturación ARCA — config por restaurante.
    // La clave privada está cifrada con master key del servidor: seguro leer desde admin.
    // Escritura solo via Cloud Functions (Admin SDK), no desde cliente.
    match /restaurants/{restaurantId}/afipConfig/{docId} {
      allow read: if isSuperAdmin() || isAdmin(restaurantId);
      allow write: if isSuperAdmin();
    }

    // Tokens ARCA cacheados (renovación automática cada ~10h por Cloud Function)
    match /restaurants/{restaurantId}/afipTokens/{docId} {
      allow read: if isSuperAdmin() || isAdmin(restaurantId);
      allow write: if isSuperAdmin();
    }

    // Lista de espera (Waitlist)
    match /restaurants/{restaurantId}/waitlist/{entryId} {
      allow read: if isSuperAdmin() || isWaitlistStaff(restaurantId);
      // Las escrituras pasan por Cloud Functions para validar transiciones,
      // evitar carreras con avisos/asignaciones y conservar historial.
      allow create, update, delete: if false;
    }

    // Reservas
    match /restaurants/{restaurantId}/reservations/{reservationId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);
      // Creación y cambios pasan por Cloud Functions para aplicar capacidad
      // por franja de forma transaccional.
      allow create, update, delete: if false;
    }

    match /restaurants/{restaurantId}/reservationSettings/{docId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);
      allow write: if false;
    }

    // Tokens usados por enlaces públicos de cancelación. Solo Cloud Functions.
    match /restaurants/{restaurantId}/reservationSecrets/{reservationId} {
      allow read, write: if false;
    }

    // Bloqueos transaccionales para evitar solapamientos de mesa.
    match /restaurants/{restaurantId}/reservationTableSlots/{slotId} {
      allow read, write: if false;
    }

    // Turnos del personal (clock in/out)
    match /restaurants/{restaurantId}/shifts/{shiftId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);
      allow create: if isSuperAdmin() || isActiveStaff(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.staffId == request.auth.uid;
      allow update: if isSuperAdmin()
        || isAdmin(restaurantId)
        || (isActiveStaff(restaurantId)
            && resource.data.staffId == request.auth.uid
            && resource.data.endedAt == null);
      allow delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    // Turnos de caja
    match /restaurants/{restaurantId}/cajaTurnos/{turnoId} {
      allow read: if isSuperAdmin() || isActiveStaff(restaurantId);

      allow create: if isCashierOrAdmin(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.openingCash is number
        && request.resource.data.openingCash >= 0;

      allow update: if isCashierOrAdmin(restaurantId)
        && resource.data.restaurantId == restaurantId
        && (resource.data.actorUid == request.auth.uid || isAdmin(restaurantId))
        && request.resource.data.restaurantId == resource.data.restaurantId;

      allow delete: if isSuperAdmin();
    }

    // Carrito compartido por mesa/sesión (acceso anónimo — seguridad via UUID sessionId)
    match /restaurants/{restaurantId}/carts/{sessionId} {
      allow read, write: if true;
    }

    // Kardex de movimientos de inventario
    match /restaurants/{restaurantId}/kardex/{entryId} {
      allow read: if isSuperAdmin() || isAdmin(restaurantId);
      allow create: if (isSuperAdmin() || isAdmin(restaurantId))
        && isPremiumRestaurant(restaurantId)
        && request.resource.data.restaurantId == restaurantId;
      allow update, delete: if false;
    }

    // Promociones y Happy Hour
    match /restaurants/{restaurantId}/promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin(restaurantId);
    }

    // Promociones 2x1
    match /restaurants/{restaurantId}/promotions2x1/{promoId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin(restaurantId);
    }
  }
}
