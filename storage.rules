rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffPath(restaurantId) {
      return /databases/(default)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid);
    }

    function isActiveStaff(restaurantId) {
      return isSignedIn()
        && firestore.exists(staffPath(restaurantId))
        && firestore.get(staffPath(restaurantId)).data.active == true;
    }

    function hasRole(restaurantId, role) {
      return isActiveStaff(restaurantId)
        && firestore.get(staffPath(restaurantId)).data.role == role;
    }

    function isAdmin(restaurantId) {
      return hasRole(restaurantId, "admin");
    }

    function isCashier(restaurantId) {
      return hasRole(restaurantId, "cashier");
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function validImageSize(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    /*
    ============================================
    BRANDING
    restaurants/{restaurantId}/branding/
    ============================================
    */

    match /restaurants/{restaurantId}/branding/{fileName} {
      allow read: if true;

      // S-01: solo admin (se eliminó cashier).
      // S-02 + S-03: el nombre debe seguir el patrón que genera el frontend
      //   (logo|cover)-{epoch}.{ext} con extensión de imagen válida.
      //   Usar el wildcard {fileName} como validación server-side evita depender
      //   del contentType que provee el cliente.
      allow write:
        if isAdmin(restaurantId)
        && fileName.matches('^(logo|cover)-[0-9]+\\.(jpg|jpeg|png|webp)$')
        && validImageSize(5);
    }

    /*
    ============================================
    MENU IMAGES
    restaurants/{restaurantId}/menu/
    ============================================
    */

    match /restaurants/{restaurantId}/menu/{allPaths=**} {
      allow read: if true;

      // S-02: se reemplaza isImage() (contentType del cliente, spoofeable) por
      //   validación de extensión sobre request.resource.name, que requiere que
      //   el cliente envíe el path con una extensión de imagen válida.
      allow write:
        if isAdmin(restaurantId)
        && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')
        && validImageSize(8);
    }

    /*
    ============================================
    BLOCK EVERYTHING ELSE
    ============================================
    */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}